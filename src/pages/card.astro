---
// rachitsharma.space/card — Interactive holographic business card
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rachit Sharma | Card</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --c1: #0a0a0f;
      --c2: #12121a;
      --neon: #00f5ff;
      --neon2: #bf5af2;
      --neon3: #ff375f;
      --gold: #ffd700;
      --text: #e8e8f0;
      --sub: #8888aa;
    }

    html, body {
      width: 100%; height: 100%;
      background: var(--c1);
      font-family: 'Space Grotesk', sans-serif;
      color: var(--text);
      overflow: hidden;
    }

    /* ── Canvas particle bg ── */
    #bg { position: fixed; inset: 0; z-index: 0; }

    /* ── Scene ── */
    .scene {
      position: fixed; inset: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      z-index: 10;
      gap: 28px;
    }

    /* ── Card wrapper (3D flip) ── */
    .card-wrap {
      width: 420px; height: 240px;
      perspective: 1200px;
      cursor: pointer;
      user-select: none;
    }

    .card-inner {
      width: 100%; height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }
    .card-wrap.flipped .card-inner { transform: rotateY(180deg); }

    /* ── Card faces ── */
    .card-face {
      position: absolute; inset: 0;
      border-radius: 20px;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      overflow: hidden;
      box-shadow:
        0 0 0 1px rgba(0,245,255,0.15),
        0 25px 60px rgba(0,0,0,0.7),
        0 0 80px rgba(0,245,255,0.08);
    }

    /* Holographic gradient overlay — follows mouse */
    .card-face::before {
      content: '';
      position: absolute; inset: 0;
      background: var(--holo, radial-gradient(circle at 50% 50%, rgba(0,245,255,0.12) 0%, transparent 70%));
      border-radius: inherit;
      pointer-events: none;
      z-index: 3;
      transition: background 0.05s;
      mix-blend-mode: screen;
    }

    /* Shine sweep */
    .card-face::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(
        105deg,
        transparent 40%,
        rgba(255,255,255,0.06) 50%,
        transparent 60%
      );
      border-radius: inherit;
      pointer-events: none;
      z-index: 4;
      transform: translateX(var(--shine-x, -100%));
      transition: transform 0.6s ease;
    }

    /* ── FRONT ── */
    .card-front {
      background:
        linear-gradient(135deg, #0d0d1a 0%, #12122a 50%, #0a0a18 100%);
    }

    /* Grid lines */
    .card-front .grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(0,245,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,245,255,0.04) 1px, transparent 1px);
      background-size: 30px 30px;
      z-index: 1;
    }

    /* Corner accent */
    .card-front .corner {
      position: absolute;
      width: 50px; height: 50px;
      border-color: rgba(0,245,255,0.4);
      border-style: solid;
      z-index: 2;
    }
    .card-front .corner.tl { top: 14px; left: 14px; border-width: 2px 0 0 2px; border-radius: 6px 0 0 0; }
    .card-front .corner.br { bottom: 14px; right: 14px; border-width: 0 2px 2px 0; border-radius: 0 0 6px 6px; }

    /* Orb */
    .card-front .orb {
      position: absolute;
      width: 160px; height: 160px;
      right: -30px; top: -30px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(191,90,242,0.3) 0%, rgba(0,245,255,0.1) 50%, transparent 70%);
      filter: blur(20px);
      z-index: 1;
      animation: orb-pulse 4s ease-in-out infinite;
    }

    @keyframes orb-pulse {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 1; }
    }

    .card-front .content {
      position: absolute; inset: 0;
      z-index: 2;
      padding: 28px 30px;
      display: flex; flex-direction: column; justify-content: space-between;
    }

    .card-front .tag {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: var(--neon);
      letter-spacing: 3px;
      text-transform: uppercase;
      opacity: 0.8;
    }

    .card-front .name {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.5px;
      line-height: 1;
      background: linear-gradient(135deg, #fff 0%, var(--neon) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .card-front .role {
      font-size: 12px;
      color: var(--sub);
      letter-spacing: 1px;
      margin-top: 4px;
    }

    .card-front .bottom {
      display: flex; justify-content: space-between; align-items: flex-end;
    }

    .card-front .contact-line {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.5);
      line-height: 1.8;
    }

    /* Holographic stripe at bottom */
    .card-front .holo-stripe {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--neon3), var(--neon2), var(--neon), var(--gold), var(--neon3));
      background-size: 200% 100%;
      animation: stripe-flow 3s linear infinite;
      z-index: 5;
    }
    @keyframes stripe-flow {
      0% { background-position: 0% 0%; }
      100% { background-position: 200% 0%; }
    }

    /* ── BACK ── */
    .card-back {
      transform: rotateY(180deg);
      background: linear-gradient(135deg, #0a0a18 0%, #0d0d1a 100%);
      display: flex; align-items: center; justify-content: center;
    }

    .card-back .grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(191,90,242,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(191,90,242,0.04) 1px, transparent 1px);
      background-size: 24px 24px;
      z-index: 1;
    }

    .card-back .back-content {
      position: relative; z-index: 2;
      display: flex; flex-direction: column; align-items: center; gap: 16px;
    }

    .card-back .qr-wrap {
      width: 90px; height: 90px;
      border-radius: 12px;
      background: white;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 0 30px rgba(0,245,255,0.3);
      overflow: hidden;
    }
    .card-back .qr-wrap canvas { border-radius: 8px; }

    .card-back .scan-label {
      font-family: 'Space Mono', monospace;
      font-size: 9px;
      color: var(--neon2);
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .card-back .socials {
      display: flex; gap: 16px;
    }
    .card-back .social-pill {
      display: flex; align-items: center; gap: 6px;
      padding: 5px 12px;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.1);
      font-size: 10px;
      color: var(--sub);
      font-family: 'Space Mono', monospace;
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }
    .card-back .social-pill:hover { border-color: var(--neon); color: var(--neon); }

    .card-back .holo-stripe {
      position: absolute; top: 0; left: 0; right: 0; height: 4px;
      background: linear-gradient(90deg, var(--neon), var(--neon2), var(--neon3), var(--gold), var(--neon));
      background-size: 200% 100%;
      animation: stripe-flow 3s linear infinite reverse;
      z-index: 5;
    }

    /* ── Tap hint ── */
    .hint {
      font-family: 'Space Mono', monospace;
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      letter-spacing: 2px;
      animation: fade-pulse 2.5s ease-in-out infinite;
    }
    @keyframes fade-pulse {
      0%, 100% { opacity: 0.4; } 50% { opacity: 1; }
    }

    /* ── Download btn ── */
    .actions {
      display: flex; gap: 12px;
    }
    .btn {
      padding: 10px 22px;
      border-radius: 30px;
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: 1px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-outline {
      border: 1px solid rgba(0,245,255,0.3);
      color: var(--neon);
      background: transparent;
    }
    .btn-outline:hover { background: rgba(0,245,255,0.08); border-color: var(--neon); }

    .btn-solid {
      border: none;
      background: linear-gradient(135deg, var(--neon2), var(--neon));
      color: #000;
      font-weight: 700;
    }
    .btn-solid:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(0,245,255,0.3); }

    /* ── Mobile ── */
    @media (max-width: 480px) {
      .card-wrap { width: 340px; height: 200px; }
      .card-front .name { font-size: 22px; }
    }
  </style>
</head>
<body>

<canvas id="bg"></canvas>

<div class="scene">
  <div class="card-wrap" id="card">
    <div class="card-inner">

      <!-- FRONT -->
      <div class="card-face card-front">
        <div class="grid"></div>
        <div class="orb"></div>
        <div class="corner tl"></div>
        <div class="corner br"></div>
        <div class="holo-stripe"></div>
        <div class="content">
          <div>
            <div class="tag" id="f-tag">Full-Stack Developer</div>
          </div>
          <div>
            <div class="name" id="f-name">YOUR NAME</div>
            <div class="role" id="f-role">Builder · Thinker · Creator</div>
          </div>
          <div class="bottom">
            <div class="contact-line" id="f-contact">
              <!-- filled by JS -->
            </div>
          </div>
        </div>
      </div>

      <!-- BACK -->
      <div class="card-face card-back">
        <div class="grid"></div>
        <div class="holo-stripe"></div>
        <div class="back-content">
          <div class="qr-wrap">
            <canvas id="qr-canvas" width="80" height="80"></canvas>
          </div>
          <div class="scan-label">Scan to connect</div>
          <div class="socials" id="back-socials"></div>
        </div>
      </div>

    </div>
  </div>

  <p class="hint">TAP TO FLIP</p>

  <div class="actions">
    <a href="#" class="btn btn-outline" id="share-btn">Share Link</a>
    <a href="#" class="btn btn-solid" id="save-btn">Save Contact</a>
  </div>
</div>

<!-- QR lib -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
// ── CONFIG — update after user provides details ──
const CARD = {
  name:    "YOUR NAME",
  role:    "Full-Stack Developer",
  email:   "you@email.com",
  phone:   "+61 400 000 000",
  website: "rachitsharma.space",
  github:  "github.com/yourhandle",
  linkedin:"linkedin.com/in/yourhandle",
  qrUrl:   "https://rachitsharma.space/card",
};

// ── Fill front ──
document.getElementById('f-name').textContent    = CARD.name;
document.getElementById('f-role').textContent    = CARD.role;
document.getElementById('f-contact').innerHTML   =
  `${CARD.email}<br>${CARD.phone}<br>${CARD.website}`;

// ── Fill back socials ──
const socialsEl = document.getElementById('back-socials');
const links = [
  { label: 'GitHub',   href: `https://${CARD.github}` },
  { label: 'LinkedIn', href: `https://${CARD.linkedin}` },
];
links.forEach(l => {
  const a = document.createElement('a');
  a.className = 'social-pill';
  a.href = l.href; a.target = '_blank';
  a.textContent = l.label;
  socialsEl.appendChild(a);
});

// ── QR code ──
function drawQR(url) {
  const canvas = document.getElementById('qr-canvas');
  // Simple manual QR placeholder until lib loads — lib replaces it
  if (window.QRCode) {
    canvas.parentElement.innerHTML = '';
    new QRCode(canvas.parentElement, {
      text: url, width: 80, height: 80,
      colorDark: '#000', colorLight: '#fff',
      correctLevel: QRCode.CorrectLevel.M
    });
  }
}
window.addEventListener('load', () => drawQR(CARD.qrUrl));

// ── Flip ──
const cardWrap = document.getElementById('card');
cardWrap.addEventListener('click', () => cardWrap.classList.toggle('flipped'));

// ── Holographic mouse tilt + shine ──
document.addEventListener('mousemove', e => {
  const rect = cardWrap.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top + rect.height / 2;
  const dx = (e.clientX - cx) / (window.innerWidth / 2);
  const dy = (e.clientY - cy) / (window.innerHeight / 2);

  const rx = -dy * 14;
  const ry = dx * 14;

  const inner = cardWrap.querySelector('.card-inner');
  inner.style.transform = cardWrap.classList.contains('flipped')
    ? `rotateY(180deg) rotateX(${-rx}deg) rotateY(${-ry}deg)`
    : `rotateX(${rx}deg) rotateY(${ry}deg)`;

  // Holographic color shift based on angle
  const hue1 = Math.round(180 + dx * 60);
  const hue2 = Math.round(280 + dy * 60);
  const holoGrad = `radial-gradient(circle at ${50 + dx*40}% ${50 + dy*40}%, hsla(${hue1},100%,70%,0.18) 0%, hsla(${hue2},100%,60%,0.08) 40%, transparent 70%)`;

  document.querySelectorAll('.card-face').forEach(f => {
    f.style.setProperty('--holo', holoGrad);
  });

  // Shine sweep on hover
  const pct = (e.clientX / window.innerWidth) * 200 - 100;
  document.querySelectorAll('.card-face').forEach(f => {
    f.style.setProperty('--shine-x', `${pct}%`);
  });
});

document.addEventListener('mouseleave', () => {
  const inner = cardWrap.querySelector('.card-inner');
  inner.style.transform = cardWrap.classList.contains('flipped')
    ? 'rotateY(180deg)' : '';
});

// ── Share ──
document.getElementById('share-btn').addEventListener('click', e => {
  e.preventDefault();
  if (navigator.share) {
    navigator.share({ title: CARD.name, url: CARD.qrUrl });
  } else {
    navigator.clipboard.writeText(CARD.qrUrl);
    e.target.textContent = 'Copied!';
    setTimeout(() => e.target.textContent = 'Share Link', 2000);
  }
});

// ── Save Contact (vCard) ──
document.getElementById('save-btn').addEventListener('click', e => {
  e.preventDefault();
  const vcard = `BEGIN:VCARD\nVERSION:3.0\nFN:${CARD.name}\nTITLE:${CARD.role}\nEMAIL:${CARD.email}\nTEL:${CARD.phone}\nURL:https://${CARD.website}\nEND:VCARD`;
  const blob = new Blob([vcard], { type: 'text/vcard' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `${CARD.name.replace(' ','_')}.vcf`;
  a.click();
});

// ── Particle background ──
(function() {
  const canvas = document.getElementById('bg');
  const ctx = canvas.getContext('2d');
  let W, H, particles = [];

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const COLORS = ['#00f5ff', '#bf5af2', '#ff375f', '#ffd700'];

  class Particle {
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = Math.random() * H;
      this.r = Math.random() * 1.2 + 0.3;
      this.vx = (Math.random() - 0.5) * 0.3;
      this.vy = (Math.random() - 0.5) * 0.3;
      this.color = COLORS[Math.floor(Math.random() * COLORS.length)];
      this.alpha = Math.random() * 0.6 + 0.1;
      this.life = 0;
      this.maxLife = 200 + Math.random() * 400;
    }
    tick() {
      this.x += this.vx; this.y += this.vy; this.life++;
      if (this.life > this.maxLife || this.x < 0 || this.x > W || this.y < 0 || this.y > H) this.reset();
    }
    draw() {
      const fade = Math.min(1, this.life / 40, (this.maxLife - this.life) / 40);
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      ctx.fillStyle = this.color;
      ctx.globalAlpha = this.alpha * fade;
      ctx.fill();
    }
  }

  for (let i = 0; i < 120; i++) particles.push(new Particle());

  // Draw connecting lines between close particles
  function drawLines() {
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 80) {
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = particles[i].color;
          ctx.globalAlpha = (1 - dist/80) * 0.12;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
  }

  function loop() {
    ctx.clearRect(0, 0, W, H);
    drawLines();
    particles.forEach(p => { p.tick(); p.draw(); });
    ctx.globalAlpha = 1;
    requestAnimationFrame(loop);
  }
  loop();
})();
</script>
</body>
</html>

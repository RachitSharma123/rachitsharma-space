<style>
.about {
  padding: 7rem 0;
  border-top: 1px solid var(--border);
}

.about-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}

.section-label {
  font-size: 0.75rem;
  color: var(--accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.2rem;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin-bottom: 2rem;
}

.about-body p {
  color: var(--muted);
  margin-bottom: 1.1rem;
  font-size: 1.05rem;
}

.about-links {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  margin-top: 2rem;
}

.ext-link {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.8rem;
  color: var(--muted);
  letter-spacing: 0.04em;
  transition: color 0.2s;
}

.ext-link:hover { color: var(--accent); }

.about-card {
  border: 1px solid var(--border);
  padding: 1.5rem;
  margin-bottom: 1.2rem;
  background: var(--bg2);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  transition: border-color 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.about-card:hover {
  border-color: rgba(245, 158, 11, 0.25);
  box-shadow: 0 8px 36px rgba(0, 0, 0, 0.38);
}

.card-label {
  font-size: 0.7rem;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
}

.card-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.card-list li {
  font-size: 0.9rem;
  color: var(--muted);
  display: flex;
  gap: 0.6rem;
  align-items: baseline;
}

.card-list li strong { color: var(--text); }
.bullet { flex-shrink: 0; font-size: 0.7rem; }

@media (max-width: 900px) {
  .about-inner { grid-template-columns: 1fr; gap: 3rem; }
}
</style>

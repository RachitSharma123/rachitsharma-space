<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left mono">
      <span class="accent">RS</span>.space &copy; {new Date().getFullYear()}
    </div>
    <div class="footer-mid mono">
      Built with Astro · Deployed on Vercel
    </div>
    <div class="footer-right">
      <a href="https://github.com/RachitSharma123" target="_blank">GitHub</a>
      <a href="https://linkedin.com/in/rachit-sharma-0b9b44117" target="_blank">LinkedIn</a>
      <a href="mailto:rachitsharma.space@gmail.com">Email</a>
    </div>
  </div>
</footer>

<style>
.footer {
  border-top: 1px solid var(--border);
  padding: 1.8rem 0;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.footer-left {
  font-size: 0.78rem;
  color: var(--muted);
  letter-spacing: 0.04em;
}

.footer-mid {
  font-size: 0.72rem;
  color: var(--muted);
  opacity: 0.5;
  letter-spacing: 0.04em;
}

.footer-right {
  display: flex;
  gap: 1.5rem;
}

.footer-right a {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: color 0.2s;
}

.footer-right a:hover { color: var(--accent); }

@media (max-width: 600px) {
  .footer-mid { display: none; }
}
</style>

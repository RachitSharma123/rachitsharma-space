---
---

<nav class="nav">
  <div class="nav-inner container">
    <a href="/" class="nav-logo mono">
      <span class="accent">RS</span><span class="muted">.space</span>
    </a>
    <div class="nav-links">
      <a href="#about">About</a>
      <a href="#stack">Stack</a>
      <a href="#projects">Build</a>
      <a href="#consulting">Consult</a>
      <a href="#contact" class="nav-cta">Hire me</a>
    </div>
    <button class="nav-toggle" id="navToggle" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <a href="#about" class="mobile-link">About</a>
  <a href="#stack" class="mobile-link">Stack</a>
  <a href="#projects" class="mobile-link">Build</a>
  <a href="#consulting" class="mobile-link">Consult</a>
  <a href="#contact" class="mobile-link accent">Hire me</a>
</div>

<style>
.nav {
  position: fixed;
  top: 30px;
  left: 0;
  right: 0;
  z-index: 100;
  border-bottom: 1px solid transparent;
  transition: all 0.3s ease;
  padding: 1.25rem 0;
}

.nav.scrolled {
  background: rgba(10, 10, 8, 0.92);
  backdrop-filter: blur(12px);
  border-bottom-color: var(--border);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-logo {
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.nav-links a {
  color: var(--muted);
  transition: color 0.2s;
}

.nav-links a:hover { color: var(--text); }

.nav-cta {
  color: var(--bg) !important;
  background: linear-gradient(135deg, var(--accent) 0%, #e8910a 100%);
  padding: 0.45rem 1.1rem;
  font-weight: 600;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  box-shadow: 0 2px 12px rgba(245, 158, 11, 0.3);
}

.nav-cta:hover {
  background: linear-gradient(135deg, #f8b429 0%, var(--accent2) 100%) !important;
  box-shadow: 0 4px 20px rgba(245, 158, 11, 0.45) !important;
}

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}

.nav-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--text);
  transition: all 0.3s;
}

.mobile-menu {
  display: none;
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 99;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2.5rem;
}

.mobile-menu.open { display: flex; }

.mobile-link {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 800;
  color: var(--muted);
  transition: color 0.2s;
  text-transform: uppercase;
}

.mobile-link:hover, .mobile-link.accent { color: var(--accent); }

@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav-toggle { display: flex; }
  .nav { top: 30px; }
}
</style>

<script>
  const nav = document.querySelector('.nav');
  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  });

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });

  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => menu?.classList.remove('open'));
  });
</script>
